# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored, so your secrets stay out of GitHub.

aws_region          = "ap-northeast-1"
line_channel_secret = "your-line-channel-secret"

# Sender must be a domain you own (NOT gmail/yahoo — their DMARC policy blocks it).
ses_sender_domain = "yourdomain.com"
ses_sender_email  = "line-notifier@yourdomain.com" # must be an address at ses_sender_domain

# Recipient can be any inbox (your Gmail/Yahoo is fine).
ses_recipient_email = "you@example.com"

# Optional for notifications; REQUIRED for the inbound (email -> group) feature.
# line_channel_access_token = "your-long-lived-channel-access-token"

# --- Inbound feature: email -> LINE group ---
# A subdomain whose MX points at SES (kept separate from your main mail domain).
inbound_subdomain = "post.yourdomain.com"
# Secret local-part; the trigger address becomes <this>@<inbound_subdomain>.
inbound_local_part = "line-CHANGEME-random"
# From addresses allowed to post (must also pass DMARC). Your normal inbox is fine.
allowed_senders = ["you@example.com"]
# The group to post into (grab the groupId from a webhook payload / notification).
line_group_id = "Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
